# Aegis environment template. Copy to .env and fill in. NEVER commit the real .env.
# (CLAUDE.md §12: no credential is ever committed, hardcoded, or logged.)

# --- Database ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aegis
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# SQLAlchemy async URL, derived from the above by core.config if unset
DATABASE_URL=postgresql+asyncpg://aegis:change-me-locally@127.0.0.1:5433/aegis

# --- Redis (cache only, never source of truth — ESD §11) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (self-issued JWT — ESD §8) ---
# Generate a strong random value locally; do not reuse across environments.
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- LLM provider (ESD §20). Real models only — there is NO stub/offline provider.
# Without working keys the system fails loudly rather than fabricating analysis. ---
LLM_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Comma-separated. Rotated automatically when one is rate-limited. NEVER commit real keys.
OPENROUTER_API_KEYS=sk-or-v1-xxxx,sk-or-v1-yyyy
# Per-agent model assignment (right-size capability to task difficulty).
LLM_MODEL_RCA=nvidia/nemotron-3-super-120b-a12b:free
LLM_MODEL_DEFAULT=nvidia/nemotron-nano-9b-v2:free
LLM_MODEL_FALLBACKS=nvidia/nemotron-nano-9b-v2:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-20b:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500
LLM_MAX_TOKENS_ON_TRUNCATION=4000
LLM_TIMEOUT_SECONDS=90

# --- Incident budgets / tuning (PRD FR-1.2, FR-3.1; ESD §15) ---
DEDUP_WINDOW_SECONDS=300
RCA_ENSEMBLE_PASSES=3
INCIDENT_TOKEN_BUDGET=200000

# --- Infra evidence sources (MCP servers, read-only in MVP) ---
PROMETHEUS_URL=http://localhost:9090
# GITHUB_TOKEN=   # read-only, repo scope; used by the GitHub MCP server only
GITHUB_REPO=Saravankumar25/aegis
GITHUB_API_URL=https://api.github.com

# k8s MCP server: dedicated aegis-k8s-mcp ServiceAccount credential (NOT the admin kubeconfig).
# Mint the git-ignored token + CA files with: bash infra/gen-mcp-credentials.sh
# K8S_API_URL is printed by that script (kind maps a random host port for the API server).
K8S_API_URL=https://127.0.0.1:6443
K8S_TOKEN_FILE=../infra/.k8s-mcp-token
K8S_CA_CERT_FILE=../infra/.k8s-mcp-ca.crt
K8S_NAMESPACE=meridian

# --- MCP tool-call resilience (ESD §12) ---
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_BASE_DELAY_SECONDS=0.2
MCP_HTTP_TIMEOUT_SECONDS=10.0

# --- API surface (M5) ---
CORS_ORIGINS=http://localhost:3000
# INGEST_WEBHOOK_TOKEN=   # shared secret for POST /api/v1/incidents; unset = open (local only)

# --- Runtime environment marker ---
# "local" (default), "test", "staging", or "production". Setting it to production is not a
# label: it switches off the interactive docs (/docs, /redoc, /openapi.json, which otherwise
# serve an unauthenticated map of the attack surface) and makes the settings object REFUSE TO
# START on any of the permissive local defaults — placeholder JWT_SECRET, unset
# INGEST_WEBHOOK_TOKEN, wildcard CORS_ORIGINS, or the example database password.
# So a production deployment must set, at minimum:
#   ENVIRONMENT=production
#   JWT_SECRET=<32+ random chars, e.g. openssl rand -hex 32>
#   INGEST_WEBHOOK_TOKEN=<shared secret the alert source sends as x-aegis-webhook-token>
#   CORS_ORIGINS=<the dashboard's exact origin, never *>
ENVIRONMENT=local

# --- Firebase Authentication + Google OAuth (ESD §8) ---
# The service-account JSON is written to a gitignored path; only the PATH lives in env.
# Obtain it from Firebase console → Project settings → Service accounts → Generate new key.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_FILE=../.secrets/firebase-service-account.json
# Fail-closed RBAC allowlists. An authenticated email in NEITHER list becomes `viewer`,
# which cannot approve a remediation. Comma-separated.
AEGIS_ADMIN_EMAILS=you@example.com
AEGIS_APPROVER_EMAILS=oncall1@example.com,oncall2@example.com

# --- Gemini (ESD §20). Independent capacity pool from OpenRouter, whose free models
# share one account-wide DAILY cap. Switch with LLM_PROVIDER=gemini. ---
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Comma-separated; rotated automatically when one is rate-limited. NEVER commit real keys.
GEMINI_API_KEYS=AQ.xxxx,AQ.yyyy
GEMINI_MODEL_RCA=gemini-3.1-flash-lite
GEMINI_MODEL_DEFAULT=gemini-3.1-flash-lite
GEMINI_MODEL_FALLBACKS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.5-flash

# --- LangSmith tracing (ESD §13). Observability is never load-bearing: every entry
# point no-ops when this is unset or unreachable. ---
LANGSMITH_API_KEY=lsv2_pt_xxxx
LANGSMITH_PROJECT=aegis
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
