# Aegis environment template. Copy to .env and fill in. NEVER commit the real .env.
# (CLAUDE.md §12: no credential is ever committed, hardcoded, or logged.)

# --- Database ---
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=aegis
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# SQLAlchemy async URL, derived from the above by core.config if unset
DATABASE_URL=postgresql+asyncpg://aegis:change-me-locally@127.0.0.1:5433/aegis

# --- Redis (cache only, never source of truth — ESD §11) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth (self-issued JWT — ESD §8) ---
# Generate a strong random value locally; do not reuse across environments.
JWT_SECRET=change-me-generate-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- LLM provider (ESD §20). Default is the deterministic stub; no key needed. ---
LLM_PROVIDER=stub
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Incident budgets / tuning (PRD FR-1.2, FR-3.1; ESD §15) ---
DEDUP_WINDOW_SECONDS=300
RCA_ENSEMBLE_PASSES=3
INCIDENT_TOKEN_BUDGET=200000

# --- Infra evidence sources (MCP servers, read-only in MVP) ---
KUBECONFIG=./infra/kind/kubeconfig
PROMETHEUS_URL=http://localhost:9090
# GITHUB_TOKEN=   # read-only, repo scope; used by the GitHub MCP server only
GITHUB_REPO=Saravankumar25/aegis
